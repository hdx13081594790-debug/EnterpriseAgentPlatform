# application
APP_NAME=Interview Agent Platform
APP_ENV=development
LOG_LEVEL=INFO

# LLM: mock（零密钥演示）/ groq / openai
LLM_PROVIDER=mock
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
OPENAI_API_KEY=

# Embedding: local_hash（零密钥）/ openai
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

# Docker Compose 中会自动改成 mysql 服务地址；本机运行可先用 SQLite
DATABASE_URL=sqlite:///./data/interview_agent.db
# MySQL 示例：mysql+pymysql://agent:agent_pass@127.0.0.1:3306/agent_platform?charset=utf8mb4

# 留空时自动降级为进程内缓存；Docker Compose 会注入 Redis 地址
REDIS_URL=
REDIS_TTL_SECONDS=900
SESSION_TTL_SECONDS=86400

RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4
RESEARCH_QUALITY_THRESHOLD=0.78
RESEARCH_MAX_REVISIONS=1

